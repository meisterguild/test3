# このリポジトリ（テンプレートリポジトリ）自身の git 管理設定。
# プロジェクトへコピーされるペイロード側の設定は template/.gitignore を参照。

# AI レビュー (push ゲート) の実行結果・raw 出力（review-runner.py が生成）
# 本リポジトリ内では基準ディレクトリのフォールバックにより template/.claude/ 側へ出力される。
# スラッシュを含むパターンはこの .gitignore の位置にアンカーされるため、両方を明示する
# （template/.gitignore 側の同名パターンに依存しない）
.claude/last-review.*
template/.claude/last-review.*

# ローカル専用の作業メモ（review-runner.py が業務 context として読む pr-draft 等）
.local/

# Python バイトコードキャッシュ
__pycache__/

# --- このリポジトリで開発するスイカゲーム（メタ層のアプリ）の生成物 -----------
# 依存とビルド成果物
node_modules/
dist/

# Playwright の実行結果・レポート
test-results/
playwright-report/
.playwright-cache/

# Vite のローカルキャッシュ
.vite/

# ローカル環境変数（NFR-03 により本来は不要だが、誤コミットの経路を塞ぐ）。
# Vite の慣習に合わせ、共有される .env / .env.production は追跡し、
# ローカル上書き分（.env.local / .env.<mode>.local）だけを ignore する。
.env.local
.env.*.local

# 個人設定のローカル上書き（例: *.local.json / settings.local.json）
*.local
*.local.*
